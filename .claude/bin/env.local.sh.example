# env.local.sh — machine-local overrides (KHÔNG commit; copy sang env.local.sh)
# Sourced tự động bởi env.sh nếu file tồn tại.
#
# Dùng để:
#   - Bật 9router và set key
#   - Đặt per-dev key cho token metering
#   - Override OPUS_BIN, CODEX_FLAGS… cho máy cụ thể
#   - Bất kỳ env var nào không nên commit vào repo

# ---- 9router gateway (bỏ comment để bật) ----
# export USE_9ROUTER=1
# export NINEROUTER_HOST=http://127.0.0.1:20128

# ---- Per-dev keys — token metering (Settings → API Keys trong dashboard 9router) ----
# Đặt tên key đúng "dev1"…"dev14" trong dashboard để group theo keyName = token theo dev.
# Nếu dev chưa có key riêng, fallback về NINEROUTER_KEY (shared key bên dưới).
#
# export NINEROUTER_KEY_DEV1=sk-9r-dev1-xxxx    # Codex medium
# export NINEROUTER_KEY_DEV2=sk-9r-dev2-xxxx    # Codex high
# export NINEROUTER_KEY_DEV3=sk-9r-dev3-xxxx    # DeepSeek S/M
# export NINEROUTER_KEY_DEV4=sk-9r-dev4-xxxx    # DeepSeek S/M
# export NINEROUTER_KEY_DEV5=sk-9r-dev5-xxxx    # Opus XL implementer
# export NINEROUTER_KEY_DEV6=sk-9r-dev6-xxxx    # Haiku M
# export NINEROUTER_KEY_DEV7=sk-9r-dev7-xxxx    # Haiku M
# export NINEROUTER_KEY_DEV8=sk-9r-dev8-xxxx    # Sonnet L
# export NINEROUTER_KEY_DEV9=sk-9r-dev9-xxxx    # Sonnet L
# export NINEROUTER_KEY_DEV10=sk-9r-dev10-xxxx  # DeepSeek post (memory scribe)
# export NINEROUTER_KEY_DEV12=sk-9r-dev12-xxxx  # Codex low (smoke tester)
# export NINEROUTER_KEY_DEV13=sk-9r-dev13-xxxx  # Codex xhigh (senior)
# export NINEROUTER_KEY_DEV14=sk-9r-dev14-xxxx  # Opus reviewer/security gate
# dev11 (Gemini) KHÔNG route qua 9router — không cần key ở đây.

# ---- Shared fallback key (dùng nếu dev chưa có key riêng) ----
# export NINEROUTER_KEY=sk-9r-shared-xxxx

# ---- Override model nếu cần ----
# export OPUS_BIN="claude --model claude-opus-4-8"
