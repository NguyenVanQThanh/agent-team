# .claude/bin/env.local.sh.example — template for per-machine secrets/overrides.
#
# Copy this file to `env.local.sh` (same dir) and fill in real values.
# `env.local.sh` is gitignored and sourced by env.sh BEFORE its defaults, so
# anything you export here wins over the committed fallbacks.
#
#   cp env.local.sh.example env.local.sh
#   # then edit env.local.sh and paste your key(s)
#
# NEVER commit env.local.sh — it holds secrets.

# ---- API keys ----
# NINEROUTER_KEY is REQUIRED for run_codex.sh / run_deepseek.sh — it renders
# into .claude/bin/settings/settings-{codex-luna,codex-terra,deepseek}.json
# (which have __NINEROUTER_KEY__ / __NINEROUTER_BASE_URL__ placeholders) so
# the Codex/DeepSeek dev lanes run `claude` against 9router with the right
# model prefix.
# NINEROUTER_BASE_URL is optional — defaults to https://9router.acegalaxy.co/v1
# if unset.
# Alternative: skip this file entirely and set both as Windows user/system
# environment variables:
#   setx NINEROUTER_KEY "sk-..."
#   setx NINEROUTER_BASE_URL "https://9router.acegalaxy.co/v1"
# They're read from the process environment either way.
# export NINEROUTER_KEY="sk-..."
# export NINEROUTER_BASE_URL="https://9router.acegalaxy.co/v1"

# Optional: other providers, if your CLI wrappers or overrides need them.
# export OPENAI_API_KEY="sk-..."
# export ANTHROPIC_API_KEY="sk-ant-..."

# ---- Local overrides ----
# Any env.sh variable can be pre-set here to override its default, e.g.:
# export CODEX_FLAGS="--settings /custom/path.json --dangerously-skip-permissions -p"
