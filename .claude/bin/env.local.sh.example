# .claude/bin/env.local.sh.example — template for per-machine secrets/overrides.
#
# Copy this file to `env.local.sh` (same dir) and fill in real values.
# `env.local.sh` is gitignored and sourced by env.sh BEFORE its defaults, so
# anything you export here wins over the committed fallbacks.
#
#   cp env.local.sh.example env.local.sh
#   # then edit env.local.sh and paste your key(s)
#
# NEVER commit env.local.sh — it holds secrets.

# ---- API keys ----
# Used by `headroom learn --model deepseek/deepseek-chat` (litellm backend) and
# by the DeepSeek CLI devs if they read it.
# export DEEPSEEK_API_KEY="sk-..."

# Optional: other providers if you route Headroom learn through them.
# export OPENAI_API_KEY="sk-..."
# export ANTHROPIC_API_KEY="sk-ant-..."

# ---- Local overrides ----
# Any env.sh variable can be pre-set here to override its default, e.g.:
# export CODEX_FLAGS_DEV1="exec --skip-git-repo-check ... model_reasoning_effort=\"high\""
